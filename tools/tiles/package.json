{
  "name": "@mmj-map/tiles",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Cut a PMTiles archive for any bounding box on earth, from public data and public tools only. No key, no account.",
  "keywords": [
    "pmtiles",
    "openstreetmap",
    "protomaps",
    "maplibre",
    "vector-tiles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta-taro/mmj-map.git",
    "directory": "tools/tiles"
  },
  "homepage": "https://meta-taro.github.io/mmj-map/",
  "bugs": {
    "url": "https://github.com/meta-taro/mmj-map/issues"
  },
  "bin": {
    "mmj-tiles": "dist/cli.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "regions",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "resolve": "tsx src/cli.ts resolve",
    "extract": "tsx src/cli.ts extract",
    "check-range": "tsx src/cli.ts check-range",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "check-age": "tsx src/cli.ts check-age"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@mmj-map/elements": "workspace:*",
    "pmtiles": "4.4.0"
  }
}
