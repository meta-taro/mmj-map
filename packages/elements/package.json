{
  "name": "@mmj-map/elements",
  "version": "0.4.0",
  "description": "Self-hosted web map as Web Components: a real map on a page with plain HTML. No API key, no per-view billing, no tile server, no build step. Works offline.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./attrs": "./src/attrs.js",
    "./palette": "./src/palette.js",
    "./provenance": "./src/provenance.js"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "keywords": [
    "map",
    "maplibre",
    "pmtiles",
    "protomaps",
    "openstreetmap",
    "web-components",
    "custom-elements",
    "vector-tiles",
    "self-hosted",
    "offline-map",
    "no-api-key",
    "static-hosting",
    "html-map",
    "google-maps-alternative",
    "mmj"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meta-taro/mmj-map.git",
    "directory": "packages/elements"
  },
  "homepage": "https://meta-taro.github.io/mmj-map/",
  "bugs": {
    "url": "https://github.com/meta-taro/mmj-map/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5",
    "pmtiles": ">=4"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "pmtiles": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "@types/node": "^26.5.1"
  }
}
