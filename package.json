{
  "name": "mmj-map",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings .",
    "gate": "pnpm lint && pnpm -r typecheck && pnpm -r test && pnpm asset:check && pnpm style:check",
    "tiles:resolve": "pnpm --filter @mmj-map/tiles-build run resolve",
    "tiles:extract": "pnpm --filter @mmj-map/tiles-build run extract",
    "tiles:check-range": "pnpm --filter @mmj-map/tiles-build run check-range",
    "serve": "pnpm --filter @mmj-map/serve run dev",
    "style:check": "pnpm --filter @mmj-map/style-check run check",
    "shot": "pnpm --filter @mmj-map/shot run shot",
    "asset:check": "pnpm --filter @mmj-map/asset-check run check",
    "tile:inspect": "pnpm --filter @mmj-map/tile-inspect run inspect",
    "palette": "pnpm --filter @mmj-map/palette run make",
    "palette:mcp": "pnpm --filter @mmj-map/palette run mcp",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "oxlint": "^1.83.0",
    "vitest": "5.0.0"
  }
}
