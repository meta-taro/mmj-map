# modern-map-japan — 環境変数のひな型
# 実際の値は .env に書き、.env はコミットしないこと。
#
# このプロダクトは、地図を表示するのに API キーを必要としません。
# ここに並ぶのは「タイルを自分でビルドして自分で配信する」ときに要る値だけです。

# ベースタイル（PMTiles）の配信元 URL。デモが読みに行く先。
# PUBLIC_TILES_URL=

# グリフ（フォント PBF）の配信元 URL。
# PUBLIC_GLYPHS_URL=

# --- タイルを自分でビルドするときだけ ---
# 生成した PMTiles の置き先（S3 互換のオブジェクトストレージを想定）。
# 単発アップロードの上限を超えるサイズになるため、分割アップロードできる経路を使うこと。
# TILE_BUCKET_NAME=
# TILE_BUCKET_ENDPOINT=
